server {
    listen 80;
    server_name aduana.streetflow.cl;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name aduana.streetflow.cl;
    ssl_certificate     /etc/letsencrypt/live/aduana.streetflow.cl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aduana.streetflow.cl/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location /media/ {
        alias /var/www/aduana-static/;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
    location /informe/ {
        alias /var/www/aduana-static/;
        index index.html;
    }
    location / {
        proxy_pass http://unix:/run/gunicorn_aduana.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    gzip on;
    gzip_types text/html text/css application/javascript image/svg+xml;
}
