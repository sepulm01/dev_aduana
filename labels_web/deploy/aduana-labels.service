[Unit]
Description=Gunicorn aduana labels (clasificador de sellos)
After=network.target

[Service]
WorkingDirectory=/var/www/aduana_labels
EnvironmentFile=/var/www/aduana_labels/.env
ExecStart=/var/www/aduana_labels/env/bin/gunicorn config.wsgi:application --bind unix:/run/gunicorn_aduana.sock --workers 2 --timeout 120
Restart=always

[Install]
WantedBy=multi-user.target
